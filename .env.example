# ==============================================================================
# Urban Furniture Accounting & ERP — Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI PROVIDER CONFIGURATION (Choose Gemini Cloud OR Local Ollama)
# ------------------------------------------------------------------------------

# Option A: Local Ollama (100% Offline / Free / Air-Gapped) - DEFAULT
# Requires Ollama running locally (https://ollama.com)
# Run: `ollama run gemma3:4b` (or qwen2.5:7b / llama3.2)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# Option B: Google Gemini (High-Speed Cloud Inference)
# Get your free key at: https://aistudio.google.com
# AI_PROVIDER=google
# GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. APPLICATION & AUTHENTICATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# NextAuth / JWT secret for session token signing
JWT_SECRET=super_secret_urban_furniture_jwt_key_change_in_production
